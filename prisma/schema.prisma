generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClothingCategory {
  TOP
  BOTTOM
  OUTERWEAR
  DRESS
  SHOES
  BAG
  ACCESSORY
}

enum Season {
  SPRING
  SUMMER
  FALL
  WINTER
  ALL_SEASON
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  password      String
  image         String?

  wardrobeItems WardrobeItem[]
  outfits       Outfit[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WardrobeItem {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  imageUrl    String
  category    ClothingCategory
  subcategory String?
  color       String
  material    String?
  pattern     String?
  seasons     Season[]

  aiAnalyzed  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([category])
}

model Outfit {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  occasion   String?
  style      String?
  weather    String?
  items      Json
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}